{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kitsune-app",
  "version": "0.1.0",
  "identifier": "revxrsal.kitsune.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../src-kitsune/src/main",
      "../src-kitsune/codegen/src/main",
      "../src-kitsune/buildSrc/src/main",
      "../src-kitsune/build.gradle.kts",
      "../src-kitsune/settings.gradle.kts",
      "../src-kitsune/codegen/build.gradle.kts",
      "../src-kitsune/buildSrc/build.gradle.kts",
      "../src-kitsune/buildSrc/settings.gradle.kts",
      "../src-kitsune/gradle/wrapper/gradle-wrapper.properties",
      "../src-kitsune/gradle/gradle-daemon-jvm.properties"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "kitsune-app",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
